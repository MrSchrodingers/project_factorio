[Unit]
Description=Factorio AI Lab dashboard
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=ti
Group=devs
WorkingDirectory=/srv/factorio-ai-lab
Environment=HOME=/home/ti
Environment=FACTORIO_AI_STATE_ROOT=/srv/factorio-ai-lab
Environment=FACTORIO_AI_VENV_FLE=/srv/factorio-ai-lab/.venv-fle
ExecStart=/srv/factorio-ai-runtime/current/scripts/run_dashboard.sh
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
