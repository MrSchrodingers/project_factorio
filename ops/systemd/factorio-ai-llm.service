[Unit]
Description=Factorio AI Lab local Qwen llama.cpp server
After=network.target

[Service]
Type=simple
User=ti
Group=devs
WorkingDirectory=/srv/factorio-ai-lab
Environment=HOME=/home/ti
Environment=FACTORIO_AI_LLM_CTX=4096
ExecStart=/srv/factorio-ai-runtime/current/scripts/run_llm_server.sh
Restart=on-failure
RestartSec=5
MemoryHigh=6G
MemoryMax=9G
MemorySwapMax=512M
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
Nice=5

[Install]
WantedBy=multi-user.target
