    "goal_progress": "satisfied_hard_postconditions / total_hard_postconditions",
    "invalid_action_rate": "invalid_or_refused_actions/proposed_actions; if proposed_actions=0 on an initially unsatisfied task, use 1",
    "missing_policy": "missing_or_unmeasured_primary_component_invalidates_the_pair; missing_is_never_zero",
    "name": "J",
    "normalized_resource_cost": "0.5*min(1,action_count/max_actions) + 0.5*min(1,observed_game_ticks/max_game_ticks)",
    "range": [
      0.0,
      1.0
    ]
  },
